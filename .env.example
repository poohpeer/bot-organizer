# Telegram. IMPORTANT: privacy mode must be DISABLED for this bot —
# BotFather -> /setprivacy -> Disable, then remove and re-add the bot to the
# group. With privacy mode on, a plain @mention never reaches the bot and it
# will appear completely dead. See docs/deployment.md.
BOT_ORGANIZER_BOT_TOKEN=

# Where ai-proxy is reachable. This bot holds no model credentials of its
# own and talks to no model provider directly — every call goes here, and
# ai-proxy is the only component that knows any provider's API or keys.
AI_PROXY_URL=http://ai-proxy:8787

# Model fallback order, as ai-proxy names them. No codex: or claude: entries:
# those adapters cannot forward tool declarations, and nearly every turn here
# needs a tool call — see bot/ai/client.py's DEFAULT_PROXY_MODELS.
AI_PROXY_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemma-4-31b-it

# Maps, not models: this one is used directly, by place lookup in
# bot/tools/external.py.
GOOGLE_MAPS_API_KEY=

# Must match the DATABASE_URL below.
POSTGRES_USER=bot_organizer
POSTGRES_PASSWORD=

# Host is `postgres` — the Compose service name, not localhost.
DATABASE_URL=postgresql://bot_organizer:CHANGEME@postgres:5432/bot_organizer

# Minimum spacing between direct-message reminders to the same person. Does
# not apply to a repeating reminder someone explicitly asked for — see
# REMINDER_MIN_REPEAT_MINUTES below.
REMINDER_MIN_INTERVAL_HOURS=6

# Floor on how tight a repeating reminder's interval can be, so "каждую
# секунду" can't be used to spam a chat.
REMINDER_MIN_REPEAT_MINUTES=5

# Used for any chat that hasn't told the bot where it is. IANA name, and it
# must be one Postgres also knows (`SELECT name FROM pg_timezone_names`) —
# Python accepts ~113 legacy aliases that Postgres rejects.
DEFAULT_TIMEZONE=Asia/Jerusalem

# The bot won't start a conversation outside these local hours.
QUIET_UNTIL_HOUR=9
QUIET_FROM_HOUR=21

# Where a CLI-backed model (Codex, Claude) reaches this bot's tools over MCP.
# Leave unset unless you run those: with no value, no grant is issued and no
# address is sent. See docs/mcp.md.
MCP_BASE_URL=
MCP_PORT=8081
MCP_GRANT_TTL_SECONDS=600

# How many recent exchanges in a chat are shown to the model. Without any,
# the bot cannot be answered: a question it asks comes back as a message it
# has no memory of prompting. Costs roughly 5% on top of a turn.
CONVERSATION_TURNS=5
# Older than this and an answer is replying to something nobody remembers
# asking, which is worse than no context at all.
CONVERSATION_MAX_AGE_MINUTES=30

# How often (seconds) the worker re-checks a chat's own title/description for
# changes. Gates get_chat per chat, not the worker's own poll cadence.
GROUP_SYNC_INTERVAL_SECONDS=60

# DEBUG traces every message through the router, every DB statement with its
# duration, and every external API call with its response. INFO keeps only
# what the bot actually did. Third-party libraries stay at INFO/WARNING either
# way — see bot/logging_setup.py.
LOG_LEVEL=DEBUG
# Longest value rendered into a single log line before it is truncated.
LOG_MAX_CHARS=300
