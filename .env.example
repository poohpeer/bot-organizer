# Telegram. IMPORTANT: privacy mode must be DISABLED for this bot —
# BotFather -> /setprivacy -> Disable, then remove and re-add the bot to the
# group. With privacy mode on, a plain @mention never reaches the bot and it
# will appear completely dead. See docs/deployment.md.
BOT_ORGANIZER_BOT_TOKEN=

# Tried first: the chain runs Groq's GPT-OSS models ahead of Gemini, so a
# Gemini rate limit no longer takes the bot down. Get one at console.groq.com.
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Must match the DATABASE_URL below.
POSTGRES_USER=bot_organizer
POSTGRES_PASSWORD=

# Host is `postgres` — the Compose service name, not localhost.
DATABASE_URL=postgresql://bot_organizer:CHANGEME@postgres:5432/bot_organizer

# Minimum spacing between direct-message reminders to the same person.
REMINDER_MIN_INTERVAL_HOURS=6

# Used for any chat that hasn't told the bot where it is. IANA name, and it
# must be one Postgres also knows (`SELECT name FROM pg_timezone_names`) —
# Python accepts ~113 legacy aliases that Postgres rejects.
DEFAULT_TIMEZONE=Asia/Jerusalem

# The bot won't start a conversation outside these local hours.
QUIET_UNTIL_HOUR=9
QUIET_FROM_HOUR=21

# DEBUG traces every message through the router, every DB statement with its
# duration, and every external API call with its response. INFO keeps only
# what the bot actually did. Third-party libraries stay at INFO/WARNING either
# way — see bot/logging_setup.py.
LOG_LEVEL=DEBUG
# Longest value rendered into a single log line before it is truncated.
LOG_MAX_CHARS=300
